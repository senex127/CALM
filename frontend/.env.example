VITE_API_URL=http://localhost:3002/api
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com

# Sous-chemin de déploiement — à renseigner UNIQUEMENT si le site est servi depuis un
# sous-dossier d'un domaine existant (ex. Setup Node.js App cPanel avec une "Application URL"
# du type exemple.fr/reservation) plutôt qu'un sous-domaine dédié ou la racine d'un domaine.
# Absent = racine ("/"), comme en développement. Voir vite.config.js et main.jsx.
# Dans ce cas, VITE_API_URL doit aussi inclure ce même préfixe (ex. https://exemple.fr/reservation/api).
VITE_BASE_PATH=

# Anti-bot à l'inscription (Cloudflare Turnstile) — clé publique, sans risque à exposer.
# Absente = le widget ne s'affiche pas, l'inscription reste possible normalement.
VITE_TURNSTILE_SITE_KEY=
