# ── Serveur ──────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# URL exacte du frontend — un seul établissement, une seule origine à autoriser en CORS.
FRONTEND_URL=http://localhost:5174

# ── Base de données (PostgreSQL — directement sur O2Switch en prod) ──
# En local avec `docker compose up`, cette valeur est ignorée : docker-compose.yml
# fournit déjà DATABASE_URL pointant vers le conteneur postgres.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# ── Auth ─────────────────────────────────────────────────────
# génération : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=une_chaine_aleatoire_longue_minimum_64_caracteres

# ── Google OAuth (Sign In With Google, côté frontend) ─────────
# Console : https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com

# ── Mailjet (emails transactionnels) ──────────────────────────
MJ_APIKEY_PUBLIC=
MJ_APIKEY_PRIVATE=
MJ_SENDER_EMAIL=contact@commealamaison.fr

# ── Anti-bot à l'inscription (Cloudflare Turnstile, gratuit) ──
# Console : https://dash.cloudflare.com/?to=/:account/turnstile
# Absente = vérification désactivée (l'inscription reste possible, juste sans ce filtre).
TURNSTILE_SECRET_KEY=
